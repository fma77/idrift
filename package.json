{
  "name": "idrift",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test \"tests/*.test.mjs\"",
    "bake": "node tools/bake-route.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply idrift-db --local",
    "db:remote": "wrangler d1 migrations apply idrift-db --remote",
    "dev:worker": "npm run build && wrangler dev",
    "setup:cloudflare": "node tools/cloudflare-setup.mjs",
    "db:reset": "wrangler d1 execute idrift-db --remote --command \"DELETE FROM scores\"",
    "db:reset:local": "wrangler d1 execute idrift-db --local --command \"DELETE FROM scores\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "wrangler": "^4.131.2"
  }
}
